{
  "name": "@ai-security-tool/locales",
  "version": "2.3.34",
  "description": "electerm multi-language support pack",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.js"
    },
    "./esm/*": "./dist/esm/*.mjs",
    "./cjs/*": "./dist/cjs/*.js"
  },
  "type": "module",
  "keywords": [
    "electerm",
    "locale",
    "language"
  ],
  "author": "ZHAO Xudong <zxdong@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/Anubis-Security-Tool/anubis-packages/tree/main/locales",
  "devDependencies": {
    "country-flag-emoji": "^1.0.3",
    "dotenv": "^16.0.3",
    "json5": "^2.2.1",
    "lodash": "^4.17.21",
    "mkdirp": "^1.0.4",
    "recursive-assign": "^0.2.0",
    "shelljs": "^0.8.5",
    "socks-proxy-agent": "^7.0.0",
    "standard": "^17.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anubis-Security-Tool/anubis-packages.git",
    "directory": "locales"
  },
  "bugs": {
    "url": "https://github.com/Anubis-Security-Tool/anubis-packages/issues"
  },
  "anubisUpstreamRepository": "git+https://github.com/ai-security-tool/locales.git"
}
